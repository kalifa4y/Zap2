# ZAP2 Environment Configuration Example

APP_NAME=ZAP2
DEBUG=False
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*
PUBLIC_URL=https://zap2.onrender.com

# Storage Paths
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
EXPORT_DIR=storage/exports
TEMP_DIR=storage/temp

# Database
DATABASE_URL=sqlite:///./zap2.db

# Whisper
DEFAULT_WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://zap2.onrender.com/api/v1/auth/youtube/callback

# TikTok for Developers (Login Kit & Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://zap2.onrender.com/api/v1/auth/tiktok/callback

# Instagram Graph API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://zap2.onrender.com/api/v1/auth/instagram/callback
